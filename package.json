{
  "name": "github-weekly-digest",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Cloudflare Worker that turns a week of GitHub activity into an LLM-written markdown report, commits it to a repo and pings Telegram",
  "keywords": ["cloudflare-workers", "github-api", "llm", "telegram-bot", "weekly-report"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgenest/evgenest-achievements.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "sync:dev-profile": "bun run scripts/sync-dev-profile.ts",
    "secret:dev-profile": "bun run deploy:prod && bun run scripts/sync-dev-profile.ts --print | wrangler secret put DEV_PROFILE --config wrangler.prod.jsonc",
    "dev:prod": "wrangler dev -c wrangler.prod.jsonc",
    "deploy:prod": "wrangler deploy -c wrangler.prod.jsonc",
    "check": "tsc --noEmit",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.52",
    "ai": "^7.0.65",
    "zod": "^4.4.3"
  }
}
