{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evgenest-achievements",
  "main": "src/index.ts",
  "account_id": "REDACTED_ACCOUNT_ID",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    // Пятница 08:00 UTC = 10:00 Берлин летом / 09:00 зимой
    // Cloudflare cron: дни недели 1=вс..7=сб (не как в обычном Unix cron), поэтому используем "fri" во избежание путаницы
    "crons": ["0 8 * * fri"]
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "REDACTED_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "GITHUB_USER": "evgenest",
    "REPORTS_REPO": "evgenest/evgenest-achievements",
    "REPORT_LANG": "ru",
    "DEV_PROFILE": "Fullstack TypeScript/JavaScript developer based in Leipzig, Germany. Works with Cloudflare Workers, Node.js/Bun, React/Next.js, Telegram bots, AI/LLM integrations.",
    // "openai" — напрямую в OpenAI; "vercel" — через Vercel AI Gateway (тот же провайдер моделей, единый биллинг)
    "LLM_PROVIDER": "vercel",
    // Формат зависит от LLM_PROVIDER: "vercel" (Gateway) требует "provider/model" (напр. "openai/gpt-5.6-luna"),
    // "openai" (прямой API) — только имя модели без префикса провайдера (напр. "gpt-5.6-luna")
    "LLM_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
    // Gateway отдаёт reasoning-уровни ("low"/"medium"/"high"/...), но конкретная модель может
    // поддерживать только toggle (вкл/выкл) — тогда SDK сам сведёт значение к ближайшему уровню
    "LLM_REASONING_EFFORT": "high"
  }
}
