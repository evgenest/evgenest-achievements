{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evgenest-achievements",
  "main": "src/index.ts",
  // account_id is intentionally NOT committed. Set CLOUDFLARE_ACCOUNT_ID in the
  // environment (locally and as a CI secret) when your API token can reach more
  // than one account.
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    // Cloudflare cron uses 1=Sun..7=Sat for numeric weekdays, so the named "fri" avoids
    // the off-by-one trap. 08:00 UTC on Friday.
    "crons": ["0 8 * * fri"]
  },
  "kv_namespaces": [
    {
      // Replace with your own namespace: `wrangler kv namespace create STATE`
      "binding": "STATE",
      "id": "REDACTED_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    // GitHub account whose activity is summarized
    "GITHUB_USER": "evgenest",
    // "<owner>/<repo>" the markdown reports are committed to. Keep it private if
    // PRIVATE_REPOS is "full" — reports then contain private repo names and commit titles.
    "REPORTS_REPO": "your-github-login/your-reports-repo",
    "REPORTS_DIR": "reports",
    // Report language: "en" or "ru" (drives report copy, achievements and the LLM prompt)
    "REPORT_LANG": "ru",
    "REPORT_TITLE": "EVGENEST Achievements",
    // IANA time zone used for dates in the report and for time-based achievements
    "TIMEZONE": "Europe/Berlin",
    // ISO 4217 code used to render the salary estimate
    "CURRENCY": "EUR",
    // "full" — private repos appear as-is; "redact" — counted, but names, commit
    // messages, titles and links are stripped; "skip" — excluded entirely.
    "PRIVATE_REPOS": "full",
    // Ask the model what the week would be worth on the market. Requires DEV_PROFILE.
    "ENABLE_SALARY_ESTIMATE": "true",
    // Upper bound on repositories inspected per run (GitHub API / subrequest budget)
    "MAX_REPOS": "15",
    // "openai" — OpenAI directly; "vercel" — through the Vercel AI Gateway
    "LLM_PROVIDER": "vercel",
    // Format depends on LLM_PROVIDER: "vercel" (Gateway) needs "provider/model",
    // "openai" (direct API) takes the bare model name.
    "LLM_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
    // The Gateway exposes reasoning levels ("low"/"medium"/"high"/...), but a given model
    // may only support an on/off toggle — the SDK then maps the value to the nearest level.
    "LLM_REASONING_EFFORT": "high"
  }
}
